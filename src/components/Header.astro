---
import ThemeToggle from './ThemeToggle.astro';
import { url } from '../utils/url';
import { SITE } from '../consts';

const links = [
  { href: '/', label: '首页' },
  { href: '/projects', label: '项目' },
  { href: '/blog', label: '笔记' },
  { href: '/about', label: '关于' },
];

// 去掉 base 前缀后再判断当前激活项，这样切到 GitHub Pages 的
// 子路径部署时导航高亮依然正确
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.slice(base.length) || '/';

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('/')}>
      <span class="brand__mark" aria-hidden="true">{SITE.mark}</span>
      <span class="brand__text">{SITE.title}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        links.map((link) => (
          <a href={url(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
